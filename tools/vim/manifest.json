{
  "$schema": "../../setup-tool/schemas/tool-manifest.schema.json",
  "destinationRoot": "$HOME",
  "files": [
    {
      "source": "posix/.vimrc",
      "destination": ".vimrc"
    },
    {
      "source": "windows/_vimrc",
      "destination": "_vimrc"
    },
    {
      "source": "macos/.gvimrc",
      "destination": ".gvimrc"
    },
    {
      "source": "posix/.vim/ftdetect/templ.vim",
      "destination": ".vim/ftdetect/templ.vim"
    },
    {
      "source": "posix/.vim/syntax/templ.vim",
      "destination": ".vim/syntax/templ.vim"
    },
    {
      "source": "posix/.vim/ftplugin/templ.vim",
      "destination": ".vim/ftplugin/templ.vim"
    },
    {
      "source": "posix/.vim/indent/templ.vim",
      "destination": ".vim/indent/templ.vim"
    }
  ]
}
