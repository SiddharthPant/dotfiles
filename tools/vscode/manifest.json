{
  "$schema": "../../setup-tool/schemas/tool-manifest.schema.json",
  "destinationRoot": "$HOME",
  "files": [
    {
      "source": "macos/settings.json",
      "destination": "Library/Application Support/Code/User/settings.json"
    },
    {
      "source": "macos/keybindings.json",
      "destination": "Library/Application Support/Code/User/keybindings.json"
    },
    {
      "source": "windows/settings.jsonc",
      "destination": "$APPDATA/Code/User/settings.json"
    }
  ]
}
