[user]
	name = SiddharthPant
	email = 10671794+SiddharthPant@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	editor = zed --wait

[sequence]
	editor = zed --wait

[fetch]
	prune = true

[pull]
	ff = only
	rebase = false

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	tool = zed

[difftool]
	prompt = false
[difftool "zed"]
	cmd = zed --wait --diff "$LOCAL" "$REMOTE"

[merge]
	tool = vscode
	conflictstyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"

[alias]
	undo = reset --mixed HEAD^

# Platform-only settings, copied by setup-tool from tools/git/<os>/.gitconfig.platform.
# Included last so they can override anything above.
[include]
	path = ~/.gitconfig.platform
