{
  "$schema": "../../crates/setup-tool/schemas/tool-manifest.schema.json",
  "destinationRoot": "$HOME/.config/zed",
  "files": [
    {
      "platform": "group:posix",
      "source": "settings.jsonc",
      "destination": "settings.json"
    },
    {
      "platform": "windows",
      "source": "settings.jsonc",
      "destination": "$env:APPDATA/Zed/settings.json"
    },
    {
      "platform": "windows",
      "source": "keymap.jsonc",
      "destination": "$env:APPDATA/Zed/keymap.json"
    }
  ]
}
