{
  "Askama expression": {
    "prefix": "var",
    "body": "{{ ${1:expression} }}",
    "description": "Askama expression"
  },
  "Askama comment": {
    "prefix": "comment",
    "body": "{# $0 #}",
    "description": "Askama comment"
  },
  "Askama if block": {
    "prefix": "if",
    "body": [
      "{% if ${1:condition} %}",
      "  $0",
      "{% endif %}"
    ],
    "description": "Askama if block"
  },
  "Askama if/else block": {
    "prefix": "ife",
    "body": [
      "{% if ${1:condition} %}",
      "  ${2}",
      "{% else %}",
      "  $0",
      "{% endif %}"
    ],
    "description": "Askama if/else block"
  },
  "Askama for block": {
    "prefix": "for",
    "body": [
      "{% for ${1:item} in ${2:items} %}",
      "  $0",
      "{% endfor %}"
    ],
    "description": "Askama for block"
  },
  "Askama for/else block": {
    "prefix": "fore",
    "body": [
      "{% for ${1:item} in ${2:items} %}",
      "  ${3}",
      "{% else %}",
      "  $0",
      "{% endfor %}"
    ],
    "description": "Askama for/else block"
  },
  "Askama match block": {
    "prefix": "match",
    "body": [
      "{% match ${1:value} %}",
      "  {% when ${2:pattern} %}",
      "    $0",
      "{% endmatch %}"
    ],
    "description": "Askama match block"
  },
  "Askama inheritance block": {
    "prefix": "block",
    "body": [
      "{% block ${1:name} %}",
      "  $0",
      "{% endblock %}"
    ],
    "description": "Askama inheritance block"
  },
  "Askama macro": {
    "prefix": "macro",
    "body": [
      "{% macro ${1:name}(${2:args}) %}",
      "  $0",
      "{% endmacro %}"
    ],
    "description": "Askama macro"
  },
  "Askama filter block": {
    "prefix": "filter",
    "body": [
      "{% filter ${1:filter} %}",
      "  $0",
      "{% endfilter %}"
    ],
    "description": "Askama filter block"
  },
  "Askama let binding": {
    "prefix": "let",
    "body": "{% let ${1:name} = ${2:value} %}",
    "description": "Askama let binding"
  },
  "Askama set binding": {
    "prefix": "set",
    "body": "{% set ${1:name} = ${2:value} %}",
    "description": "Askama set binding"
  },
  "Askama include": {
    "prefix": "include",
    "body": "{% include \"${1:path}\" %}",
    "description": "Askama include"
  },
  "Askama template inheritance": {
    "prefix": "extends",
    "body": "{% extends \"${1:path}\" %}",
    "description": "Askama template inheritance"
  }
}
