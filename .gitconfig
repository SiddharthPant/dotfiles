[core]
	excludesfile = /Users/sid/.config/git/ignore
	editor = vim

[user]
	email = 10671794+SiddharthPant@users.noreply.github.com
	name = SiddharthPant

[pull]
  ff = only
  rebase = false

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	tool = vimdiff

[difftool]
	prompt = false

[alias]
	undo = reset --mixed HEAD^

