// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "disable_ai": true,
  "show_edit_predictions": false,
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "snippet_sort_order": "none",
  "cli_default_open_behavior": "new_window",
  "always_treat_brackets_as_autoclosed": true,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
    "allow_data_collection": "no",
  },
  "buffer_font_family": "Maple Mono NF",
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "agent_buffer_font_size": 9,
  "agent_ui_font_size": 11,
  "terminal": {
    "font_size": 10,
  },
  "theme": "One Dark",
  "theme_overrides": {
    "One Dark": {
      "background": "#101010",
      "surface.background": "#101010",
      "elevated_surface.background": "#161616",
      "editor.background": "#101010",
      "editor.foreground": "#c8c8c8",
      "editor.gutter.background": "#101010",
      "editor.active_line.background": "#00000000",
      "editor.active_line_number": "#777777",
      "editor.line_number": "#404040",
      "editor.hover_line_number": "#777777",
      "editor.wrap_guide": "#242424",
      "editor.active_wrap_guide": "#404040",
      "panel.background": "#101010",
      "title_bar.background": "#101010",
      "title_bar.inactive_background": "#101010",
      "toolbar.background": "#101010",
      "tab_bar.background": "#101010",
      "tab.active_background": "#161616",
      "tab.inactive_background": "#101010",
      "status_bar.background": "#101010",
      "terminal.background": "#101010",
      "terminal.foreground": "#c8c8c8",
      "terminal.bright_foreground": "#e0e0e0",
      "terminal.dim_foreground": "#626262",
      "terminal.ansi.black": "#101010",
      "terminal.ansi.red": "#a87575",
      "terminal.ansi.green": "#8f9b82",
      "terminal.ansi.yellow": "#b3b39e",
      "terminal.ansi.blue": "#87939e",
      "terminal.ansi.magenta": "#9b8f9f",
      "terminal.ansi.cyan": "#82999b",
      "terminal.ansi.white": "#c8c8c8",
      "terminal.ansi.bright_black": "#626262",
      "terminal.ansi.bright_red": "#c08a8a",
      "terminal.ansi.bright_green": "#a8b39d",
      "terminal.ansi.bright_yellow": "#d0c0a0",
      "terminal.ansi.bright_blue": "#9eabb7",
      "terminal.ansi.bright_magenta": "#b2a3b6",
      "terminal.ansi.bright_cyan": "#9eb6b8",
      "terminal.ansi.bright_white": "#e0e0e0",
      "terminal.ansi.dim_black": "#101010",
      "terminal.ansi.dim_red": "#6f4d4d",
      "terminal.ansi.dim_green": "#5f6758",
      "terminal.ansi.dim_yellow": "#756f62",
      "terminal.ansi.dim_blue": "#596168",
      "terminal.ansi.dim_magenta": "#665e68",
      "terminal.ansi.dim_cyan": "#566668",
      "terminal.ansi.dim_white": "#888888",
      "border": "#242424",
      "border.variant": "#242424",
      "border.focused": "#404040",
      "border.selected": "#404040",
      "pane.focused_border": "#00000000",
      "text": "#c8c8c8",
      "text.muted": "#777777",
      "text.disabled": "#4a4a4a",
      "text.placeholder": "#626262",
      "icon": "#c8c8c8",
      "icon.muted": "#777777",
      "icon.disabled": "#4a4a4a",
      "icon.placeholder": "#626262",
      "element.background": "#00000000",
      "element.hover": "#181818",
      "element.active": "#242424",
      "element.selected": "#242424",
      "ghost_element.background": "#00000000",
      "ghost_element.hover": "#181818",
      "ghost_element.active": "#242424",
      "ghost_element.selected": "#242424",
      "scrollbar.track.background": "#00000000",
      "scrollbar.thumb.background": "#55555566",
      "scrollbar.thumb.hover_background": "#77777788",
      "search.match_background": "#4a4a4a80",
      "search.active_match_background": "#77777780",
      "players": [
        {
          "cursor": "#ffffff",
          "background": "#777777",
          "selection": "#303030",
        },
      ],
      "accents": [
        "#555555",
        "#626262",
        "#777777",
        "#888888",
        "#999999",
        "#aaaaaa",
      ],
      "syntax": {
        "attribute": { "color": "#c8c8c8" },
        "boolean": { "color": "#b3b39e" },
        "comment": {
          "color": "#626262",
          "font_style": "italic",
        },
        "comment.doc": {
          "color": "#626262",
          "font_style": "italic",
        },
        "constant": { "color": "#b3b39e" },
        "constructor": { "color": "#c8c8c8" },
        "diff.minus": { "color": "#888888" },
        "diff.plus": { "color": "#c8c8c8" },
        "embedded": { "color": "#c8c8c8" },
        "emphasis": { "color": "#c8c8c8" },
        "emphasis.strong": {
          "color": "#e0e0e0",
          "font_weight": null,
        },
        "enum": { "color": "#cccccc" },
        "function": { "color": "#c8c8c8" },
        "hint": { "color": "#626262" },
        "keyword": {
          "color": "#e0e0e0",
          "font_style": "italic",
        },
        "label": { "color": "#c8c8c8" },
        "link_text": {
          "color": "#c8c8c8",
          "font_style": null,
        },
        "link_uri": { "color": "#b3b39e" },
        "namespace": { "color": "#c8c8c8" },
        "number": { "color": "#b3b39e" },
        "operator": { "color": "#888888" },
        "predictive": {
          "color": "#626262",
          "font_style": null,
        },
        "preproc": { "color": "#e0e0e0" },
        "primary": { "color": "#c8c8c8" },
        "property": { "color": "#c8c8c8" },
        "punctuation": { "color": "#888888" },
        "punctuation.bracket": { "color": "#888888" },
        "punctuation.delimiter": { "color": "#888888" },
        "punctuation.list_marker": { "color": "#888888" },
        "punctuation.markup": { "color": "#888888" },
        "punctuation.special": { "color": "#888888" },
        "selector": { "color": "#c8c8c8" },
        "selector.pseudo": { "color": "#c8c8c8" },
        "string": { "color": "#b3b39e" },
        "string.escape": { "color": "#b3b39e" },
        "string.regex": { "color": "#b3b39e" },
        "string.special": { "color": "#b3b39e" },
        "string.special.symbol": { "color": "#b3b39e" },
        "tag": { "color": "#c8c8c8" },
        "text.literal": { "color": "#b3b39e" },
        "title": {
          "color": "#e0e0e0",
          "font_weight": null,
        },
        "type": { "color": "#cccccc" },
        "variable": { "color": "#c8c8c8" },
        "variable.parameter": { "color": "#c8c8c8" },
        "variable.special": { "color": "#b3b39e" },
        "variant": { "color": "#cccccc" },
      },
    },
  },
  "soft_wrap": "editor_width",
  "project_panel": {
    "hide_root": true,
    "diagnostic_badges": true,
    "scrollbar": {
      "horizontal_scroll": false,
    },
    "folder_icons": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_types": {
    "env": ["env", ".env.*"],
  },
}
