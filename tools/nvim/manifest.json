{
  "$schema": "../../setup-tool/schemas/tool-manifest.schema.json",
  "destinationRoot": "$HOME/.config/nvim",
  "files": [
    {
      "source": "posix/init.lua",
      "destination": "init.lua"
    },
    {
      "source": "posix/nvim-pack-lock.json",
      "destination": "nvim-pack-lock.json"
    },
    {
      "source": "posix/snippets/package.json",
      "destination": "snippets/package.json"
    },
    {
      "source": "posix/snippets/datastar.json",
      "destination": "snippets/datastar.json"
    },
    {
      "source": "posix/queries/datastar-injections.scm",
      "destination": "after/queries/html/injections.scm"
    },
    {
      "source": "posix/queries/datastar-injections.scm",
      "destination": "after/queries/templ/injections.scm"
    }
  ]
}
