[core]
	excludesfile = /Users/sid/.config/git/ignore
	editor = code -w

[sequence]
    editor = code -w

[user]
	email = 10671794+SiddharthPant@users.noreply.github.com
	name = SiddharthPant

[pull]
  ff = only
  rebase = false

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[diff]
  algorithm = histogram

[difftool]
  prompt = false
[difftool "vscode"]
  cmd = code --wait --diff "$LOCAL" "$REMOTE"
[difftool "zed"]
  cmd = zed --wait --diff "$LOCAL" "$REMOTE"

[merge]
  tool = vscode
  conflictstyle = zdiff3
[mergetool "vscode"]
  cmd = code --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"

[alias]
	undo = reset --mixed HEAD^
[init]
	defaultBranch = main
