# Font
font-family = Iosevka NFM
font-size = 16

# Cursor
cursor-style = block
shell-integration-features = no-cursor,ssh-env,path

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

# Tab switching with Ctrl+number instead of Cmd+number
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Make pane separator more visible
split-divider-color = #8c959f

# Force zero border padding
window-padding-x = 0
window-padding-y = 0

# Distribute remaining cell-grid pixels evenly
window-padding-balance = true
