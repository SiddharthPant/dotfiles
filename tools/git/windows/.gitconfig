[user]
	name = SiddharthPant
	email = 10671794+SiddharthPant@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	editor = code --wait
	autocrlf = input
	longpaths = true

[sequence]
	editor = code --wait

[fetch]
	prune = true

[pull]
	ff = only
	rebase = false

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	tool = vscode

[difftool]
	prompt = false
[difftool "vscode"]
	cmd = code --wait --diff "$LOCAL" "$REMOTE"

[merge]
	tool = vscode
	conflictstyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"

[alias]
	undo = reset --mixed HEAD^

[credential]
	helper = manager

[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || 'C:\\Users\\sidpa\\AppData\\Local\\Microsoft\\WinGet\\Links\\mise.exe' x hk -- hk run pre-push --from-hook
	event = pre-push
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || 'C:\\Users\\sidpa\\AppData\\Local\\Microsoft\\WinGet\\Links\\mise.exe' x hk -- hk run pre-commit --from-hook --staged
	event = pre-commit
