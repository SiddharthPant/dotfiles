{
  "$schema": "../../crates/setup-tool/schemas/tool-manifest.schema.json",
  "destinationRoot": "$HOME/.pi",
  "files": [
    {
      "platform": "group:posix",
      "source": "agent/settings.json",
      "destination": "agent/settings.json"
    },
    {
      "platform": "windows",
      "source": "agent/settings.json",
      "destination": "agent/settings.json"
    },
    {
      "source": "web-search.json",
      "destination": "agent/web-search.json"
    },
    {
      "source": "agent/extensions/statusline.ts",
      "destination": "agent/extensions/statusline.ts"
    },
    {
      "source": "agent/extensions/openai-fast.ts",
      "destination": "agent/extensions/openai-fast.ts"
    },
    {
      "source": "agent/extensions/exit.ts",
      "destination": "agent/extensions/exit.ts"
    },
    {
      "source": "agent/extensions/webfetch.ts",
      "destination": "agent/extensions/webfetch.ts"
    }
  ]
}
